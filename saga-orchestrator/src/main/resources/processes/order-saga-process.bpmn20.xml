<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:flowable="http://flowable.org/bpmn"
  targetNamespace="http://www.flowable.org/processdef">

  <process id="orderSagaProcess" name="Order Saga Process" isExecutable="true">

    <!-- Start -->
    <startEvent id="startEvent" name="Start" />

    <!-- Step 1: Create Order Command -->
    <sequenceFlow id="s1" sourceRef="startEvent" targetRef="taskCreateOrderCommand"/>
    <serviceTask id="taskCreateOrderCommand" name="Send Create Order Command"
      flowable:delegateExpression="${createOrderCommandDelegate}"
      flowable:asyncLeave="true"/>

    <!-- Compensation boundary (register handler) -->
    <boundaryEvent id="beCompensateOrder" name="Compensate Order" attachedToRef="taskCreateOrderCommand">
      <compensateEventDefinition />
    </boundaryEvent>
    <!-- Compensation handler activity (no incoming/outgoing sequence flows) -->
    <serviceTask id="taskCompensateOrder" name="Cancel Order"
      isForCompensation="true"
      flowable:delegateExpression="${cancelOrderCommandDelegate}"/>

    <!-- Wait for Order Created / Failed / Timeout -->
    <sequenceFlow id="s2" sourceRef="taskCreateOrderCommand" targetRef="gwOrderCreatedWait"/>
    <eventBasedGateway id="gwOrderCreatedWait" name="Wait for Order Created Event"/>

    <sequenceFlow id="s2a" sourceRef="gwOrderCreatedWait" targetRef="evOrderCreated"/>
    <intermediateCatchEvent id="evOrderCreated" name="Order Created Event">
      <messageEventDefinition messageRef="orderCreatedMessage"/>
    </intermediateCatchEvent>

    <sequenceFlow id="s2b" sourceRef="gwOrderCreatedWait" targetRef="evOrderCreationFailed"/>
    <intermediateCatchEvent id="evOrderCreationFailed" name="Order Creation Failed Event">
      <messageEventDefinition messageRef="orderCreationFailedMessage"/>
    </intermediateCatchEvent>

    <sequenceFlow id="s2c" sourceRef="gwOrderCreatedWait" targetRef="evOrderCreationTimeout"/>
    <intermediateCatchEvent id="evOrderCreationTimeout" name="Order Creation Timeout">
      <timerEventDefinition>
        <timeDuration>PT10S</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <!-- Step 2: Reserve Inventory -->
    <sequenceFlow id="s3" sourceRef="evOrderCreated" targetRef="taskReserveInventoryCommand"/>
    <serviceTask id="taskReserveInventoryCommand" name="Send Reserve Inventory Command"
      flowable:delegateExpression="${reserveInventoryCommandDelegate}"
      flowable:asyncLeave="true"/>

    <!-- Compensation boundary (register handler) -->
    <boundaryEvent id="beCompensateInventory" name="Compensate Inventory" attachedToRef="taskReserveInventoryCommand">
      <compensateEventDefinition />
    </boundaryEvent>
    <serviceTask id="taskCompensateInventory" name="Cancel Inventory Reservation"
      isForCompensation="true"
      flowable:delegateExpression="${compensateInventoryCommandDelegate}"/>

    <sequenceFlow id="s4" sourceRef="taskReserveInventoryCommand" targetRef="gwInventoryReservedWait"/>
    <eventBasedGateway id="gwInventoryReservedWait" name="Wait for Inventory Reserved"/>

    <sequenceFlow id="s4a" sourceRef="gwInventoryReservedWait" targetRef="evInventoryReservedSuccess"/>
    <intermediateCatchEvent id="evInventoryReservedSuccess" name="Inventory Reserved Success">
      <messageEventDefinition messageRef="inventoryReservedSuccessMessage"/>
    </intermediateCatchEvent>

    <sequenceFlow id="s4b" sourceRef="gwInventoryReservedWait" targetRef="evInventoryReservedFailure"/>
    <intermediateCatchEvent id="evInventoryReservedFailure" name="Inventory Reserved Failure">
      <messageEventDefinition messageRef="inventoryReservedFailureMessage"/>
    </intermediateCatchEvent>

    <sequenceFlow id="s4c" sourceRef="gwInventoryReservedWait" targetRef="evInventoryTimeout"/>
    <intermediateCatchEvent id="evInventoryTimeout" name="Inventory Reservation Timeout">
      <timerEventDefinition>
        <timeDuration>PT10S</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <!-- Step 3: Payment -->
    <sequenceFlow id="s5" sourceRef="evInventoryReservedSuccess" targetRef="taskProcessPaymentCommand"/>
    <serviceTask id="taskProcessPaymentCommand" name="Send Process Payment Command"
      flowable:delegateExpression="${processPaymentCommandDelegate}"
      flowable:asyncLeave="true"/>

    <sequenceFlow id="s6" sourceRef="taskProcessPaymentCommand" targetRef="gwPaymentProcessedWait"/>
    <eventBasedGateway id="gwPaymentProcessedWait" name="Wait for Payment Processed"/>

    <sequenceFlow id="s6a" sourceRef="gwPaymentProcessedWait" targetRef="evPaymentProcessedSuccess"/>
    <intermediateCatchEvent id="evPaymentProcessedSuccess" name="Payment Processed Success">
      <messageEventDefinition messageRef="paymentProcessedSuccessMessage"/>
    </intermediateCatchEvent>

    <sequenceFlow id="s6b" sourceRef="gwPaymentProcessedWait" targetRef="evPaymentProcessedFailure"/>
    <intermediateCatchEvent id="evPaymentProcessedFailure" name="Payment Processed Failure">
      <messageEventDefinition messageRef="paymentProcessedFailureMessage"/>
    </intermediateCatchEvent>

    <sequenceFlow id="s6c" sourceRef="gwPaymentProcessedWait" targetRef="evPaymentTimeout"/>
    <intermediateCatchEvent id="evPaymentTimeout" name="Payment Processing Timeout">
      <timerEventDefinition>
        <timeDuration>PT10S</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <!-- On payment failure or timeout: trigger compensation in defined order -->
    <sequenceFlow id="sfPayFailToComp1" sourceRef="evPaymentProcessedFailure" targetRef="throwCompInventory"/>
    <sequenceFlow id="sfPayTimeoutToComp1" sourceRef="evPaymentTimeout" targetRef="throwCompInventory"/>

    <!-- First: compensate Inventory -->
    <intermediateThrowEvent id="throwCompInventory" name="Throw Compensation (Inventory)">
      <compensateEventDefinition activityRef="taskReserveInventoryCommand" />
    </intermediateThrowEvent>

    <sequenceFlow id="sfComp1ToComp2" sourceRef="throwCompInventory" targetRef="throwCompOrder"/>

    <!-- Then: compensate Order -->
    <intermediateThrowEvent id="throwCompOrder" name="Throw Compensation (Order)">
      <compensateEventDefinition activityRef="taskCreateOrderCommand" />
    </intermediateThrowEvent>

    <sequenceFlow id="sfCompToEnd" sourceRef="throwCompOrder" targetRef="endFailure"/>
    <endEvent id="endFailure" name="Saga Failed"/>

    <!-- Step 4: Shipment (on payment success) -->
    <sequenceFlow id="s7" sourceRef="evPaymentProcessedSuccess" targetRef="taskCreateShipmentCommand"/>
    <serviceTask id="taskCreateShipmentCommand" name="Send Create Shipment Command"
      flowable:delegateExpression="${createShipmentCommandDelegate}"
      flowable:asyncLeave="true"/>

    <sequenceFlow id="s8" sourceRef="taskCreateShipmentCommand" targetRef="gwShipmentCreatedWait"/>
    <eventBasedGateway id="gwShipmentCreatedWait" name="Wait for Shipment Created"/>

    <sequenceFlow id="s8a" sourceRef="gwShipmentCreatedWait" targetRef="evShipmentCreatedSuccess"/>
    <intermediateCatchEvent id="evShipmentCreatedSuccess" name="Shipment Created Success">
      <messageEventDefinition messageRef="shipmentCreatedSuccessMessage"/>
    </intermediateCatchEvent>

    <sequenceFlow id="s8c" sourceRef="gwShipmentCreatedWait" targetRef="evShipmentTimeout"/>
    <intermediateCatchEvent id="evShipmentTimeout" name="Shipment Creation Timeout">
      <timerEventDefinition>
        <timeDuration>PT10S</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <sequenceFlow id="s9" sourceRef="evShipmentCreatedSuccess" targetRef="endSuccess"/>
    <endEvent id="endSuccess" name="Saga Completed"/>

    <!-- ===== All artifacts (associations) MUST come after flow elements (per BPMN XSD order) ===== -->
    <association id="assocCompensateOrder" sourceRef="beCompensateOrder" targetRef="taskCompensateOrder" associationDirection="None"/>
    <association id="assocCompensateInventory" sourceRef="beCompensateInventory" targetRef="taskCompensateInventory" associationDirection="None"/>

  </process>

  <!-- Messages -->
  <message id="orderCreatedMessage" name="orderCreated"/>
  <message id="orderCreationFailedMessage" name="orderCreationFailed"/>
  <message id="inventoryReservedSuccessMessage" name="inventoryReservedSuccess"/>
  <message id="inventoryReservedFailureMessage" name="inventoryReservedFailure"/>
  <message id="paymentProcessedSuccessMessage" name="paymentProcessedSuccess"/>
  <message id="paymentProcessedFailureMessage" name="paymentProcessedFailure"/>
  <message id="shipmentCreatedSuccessMessage" name="shipmentCreatedSuccess"/>

</definitions>